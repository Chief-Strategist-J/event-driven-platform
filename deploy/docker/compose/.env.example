# Copy to .env (next to docker-compose.all.yml, or pass --env-file). Every value shown is the built-in default;
# the stack runs with zero configuration.

# --- Naming / images ---------------------------------------------------------
COMPOSE_PROJECT_NAME=event-driven-platform
EDP_IMAGE=chiefj/event-driven-platform
EDP_TAG=latest
POSTGRES_IMAGE=postgres:16-bookworm
KAFKA_IMAGE=apache/kafka:3.8.0
APICURIO_IMAGE=apicurio/apicurio-registry-mem:2.6.5.Final
DEBEZIUM_IMAGE=debezium/connect:2.7.3.Final
PROMETHEUS_IMAGE=prom/prometheus:v2.54.1

# --- Host ports (published on EDP_BIND_ADDR only) -----------------------------
EDP_BIND_ADDR=127.0.0.1
EDP_API_PORT=8080
EDP_ADMIN_PORT=8081
EDP_POSTGRES_PORT=15432
EDP_PROMETHEUS_PORT=9090          # only with: --profile observability

# --- Database (password must be URL-safe: it is embedded in DATABASE_URL) ----
POSTGRES_DB=event_store
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres        # CHANGE for anything beyond local use

# --- App ----------------------------------------------------------------------
ENVIRONMENT=production
MAX_REQUEST_BODY_BYTES=1048576

# --- Hardening ----------------------------------------------------------------
# Set to false if the host AppArmor profile blocks exec under no-new-privileges
# (symptom: "exec /usr/bin/tini: operation not permitted"). See docs/adr/ADR-0003.
NO_NEW_PRIVILEGES=true
