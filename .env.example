# Event-Driven Platform - Environment Variables
# Conforming to 12-factor configuration standards and 09-test-writing.md

# Application & HTTP Bindings
PORT=8080
ADMIN_PORT=8081
ADMIN_HOST=127.0.0.1
ENVIRONMENT=local

# PostgreSQL Database Connection
# Used by Chassis migrations, Transactional Outbox, and Idempotent Consumers
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=event_store
DB_SSLMODE=disable
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/event_store?sslmode=disable

# Apache Kafka Message Broker
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_TOPIC_PREFIX=event_platform

# Schema Registry
SCHEMA_REGISTRY_URL=http://127.0.0.1:8082/apis/registry/v2

# OpenTelemetry Distributed Tracing & Observability
OTEL_SERVICE_NAME=event-driven-platform
OTEL_EXPORTER_OTLP_ENDPOINT=127.0.0.1:4317
OTEL_EXPORTER_OTLP_INSECURE=true

# Logging & Metrics
LOKI_URL=http://127.0.0.1:3100
PROMETHEUS_PORT=9090
TEMPO_URL=http://127.0.0.1:3200
